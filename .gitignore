# ==============================================================================
# Git Ignore Configuration
# Project: Forest Fire Risk Assessment & Predictive Analytics Workstation
# ==============================================================================

# ------------------------------------------------------------------------------
# Python Bytecode & Compilation Cache
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll

# ------------------------------------------------------------------------------
# Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Build, Distribution & Packaging Artifacts
# ------------------------------------------------------------------------------
build/
dist/
bin/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller temporary files (keep project spec file)
*.manifest
# Exempt customized project build spec
!ForestFireWorkstation.spec

# Release packages and large binary archives
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.iso

# ------------------------------------------------------------------------------
# Streamlit & Local App Runtime Cache
# ------------------------------------------------------------------------------
.streamlit/secrets.toml
.streamlit/credentials.toml
.streamlit/cache/

# ------------------------------------------------------------------------------
# Environment Variables & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Jupyter Notebook Checkpoints
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# Testing, Coverage & Code Quality Tools
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py,cover
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# IDE & Code Editor Settings
# ------------------------------------------------------------------------------
# Visual Studio Code: ignore user-specific state, preserve team settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/
*.iws
*.iml

# Other editors
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.cursor/

# ------------------------------------------------------------------------------
# Temporary Files, Logs & Process Dumps
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.pid
*.orig

# ------------------------------------------------------------------------------
# Operating System Generated Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.fuse_hidden*
.directory
.Trash-*
